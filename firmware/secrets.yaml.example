# SoilSitter secrets template
#
#   cp secrets.yaml.example secrets.yaml      # then fill it in
#
# secrets.yaml is gitignored. Never commit the filled-in copy.

wifi_ssid: "YourWiFi"
wifi_password: "your-wifi-password"

# Fallback access point, used only when the node cannot join the network.
# At least 8 characters.
ap_password: "soilsitter"

# ESPHome native API encryption. Generate one:
#   openssl rand -base64 32
# Paste the same value into Home Hub when it adopts the node.
api_encryption_key: "REPLACE_WITH_openssl_rand_base64_32"

# OTA password (ESPHome's own OTA, not the hub's API key).
ota_password: "soilsitter-ota"
